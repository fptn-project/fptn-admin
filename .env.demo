# Copy to .env and adjust.

JWT_TTL_MINUTES=60

# First panel admin, seeded on startup if admins.json is empty.
# Defaults to admin/admin (Grafana-style) — login then returns
# mustChangePassword=true until you change it.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Allowed CORS origins (comma-separated, "*" = any). Narrow to the frontend
# origin in production, e.g. https://admin.example.com
CORS_ORIGINS=*

# Access-link compression.
ENABLE_BROTLI_COMPRESSION=false

# First-run seed for bot_settings.json (telegram token, bot on/off, service
# name, default speed, welcome messages). Once that file exists, the panel's
# Settings page is authoritative and these env vars are ignored.
TELEGRAM_TOKEN=
BOT_ENABLED=false
SERVICE_NAME=fptn
MAX_USER_SPEED_LIMIT=100
WELCOME_MESSAGE_EN=
WELCOME_MESSAGE_RU=

# Folder holding users.list / admins.json / bot_settings.json — point this at
# the same folder the fptn server and telegram-bot use.
FPTN_CONFIGS_FOLDER=./compose-data
