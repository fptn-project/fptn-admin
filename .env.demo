# Copy to .env and adjust:  cp .env.demo .env
# The defaults work out of the box.

# Host port for the admin panel web UI (HTTPS).
PANEL_PORT=2663

# ============================================================================
# FPTN VPN SERVER
# ============================================================================
# Public TCP port clients connect to (looks like plain HTTPS).
FPTN_PORT=443

# Server's public IPv4/IPv6 addresses, comma-separated (optional). Set ALL of
# them to prevent proxy loops when the server reaches itself.
SERVER_EXTERNAL_IPS=

# Detect non-FPTN clients / probing during the TLS handshake. (true/false)
ENABLE_DETECT_PROBING=true

# Decoy domains for non-VPN (scanner) traffic: such a client is proxied to a
# real site, so the server looks like an ordinary HTTPS host. Pick always-
# reachable TLS 1.3 sites and verify each is live FROM THIS server.
ALLOWED_SNI_LIST=dashboard.cdnvideo.ru,cdnvideo.ru,gosuslugi.ru,sber.ru,id.sber.ru,tbank.ru,cdn.tbank.ru,alfabank.ru,mos.ru,vk.com,wildberries.ru,ozon.ru,2gis.ru,mts.ru,dzen.ru,vprok.ru,x5.ru,perekrestok.ru,yandex.ru,yandex.com,yandex.net,max.ru,google.com,cloudflare.com

# Block ads/trackers by SNI. (true/false)
ENABLE_ADS_FILTER=true
# Ad/tracker domain lists, comma-separated. Cached in DATA_DIR, refreshed hourly.
ADS_BLOCKLIST_URLS=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/ultimate-onlydomains.txt,https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts

# Where the server caches downloaded lists (inside the mounted volume).
DATA_DIR=/etc/fptn/data

# Block BitTorrent traffic. (true/false)
ENABLE_TORRENT_FILTER=true

# Block traffic that gets the server blacklisted: outgoing mail (25/465/587/2525),
# telnet (23), NetBIOS/SMB (135/137-139/445), amplification (UDP 1900/11211).
# NOTE: also blocks desktop mail clients sending mail through the tunnel.
ENABLE_SPAM_FILTER=true

# Block blacklisted domains by SNI + the IPs they resolve to. (true/false)
ENABLE_DOMAIN_BLACKLIST_FILTER=true
# Domain lists to block, comma-separated. Cached in DATA_DIR/blacklist, hourly.
DOMAIN_BLACKLIST_URLS=https://raw.githubusercontent.com/fptn-project/fptn/refs/heads/master/deploy/domain_blacklist/russia.txt

# Max IP packet size (padded up due to obfuscation).
MTU_SIZE=1400

# Cluster mode: redirect authorization to a master FPTN server. (true/false)
USE_REMOTE_SERVER_AUTH=false
REMOTE_SERVER_AUTH_HOST=
REMOTE_SERVER_AUTH_PORT=443

# Key for Prometheus to read server stats. Alphanumeric only, no spaces.
PROMETHEUS_SECRET_ACCESS_KEY=

# Max simultaneous sessions per VPN user.
MAX_ACTIVE_SESSIONS_PER_USER=3

# DNS for VPN clients: unbound (recursive resolver) or dnsmasq (forwarder).
USING_DNS_SERVER=unbound
DNS_IPV6_ENABLE=false
DNS_IPV4_PRIMARY=8.8.8.8
DNS_IPV4_SECONDARY=8.8.4.4
DNS_IPV6_PRIMARY=2001:4860:4860::8888
DNS_IPV6_SECONDARY=2001:4860:4860::8844
